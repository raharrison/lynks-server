{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "https://github.com/raharrison/lynks-server/config/lynks.schema.json",
    "type": "object",
    "title": "Lynks configuration schema",
    "description": "Describes options to configure a Lynks server deployment",
    "examples": [
        {
            "$schema": "https://raw.githubusercontent.com/raharrison/lynks-server/master/config/lynks.schema.json",
            "server": {
                "host": "127.0.0.1",
                "port": 8080,
                "rootPath": "/api"
            },
            "auth": {
                "enabled": true,
                "passwordLoginEnabled": true,
                "defaultUserName": "user",
                "defaultUserPassword": "abcdef123",
                "session": {
                    "idleDays": 30,
                    "maxDays": 90
                },
                "oidc": {
                    "enabled": true,
                    "issuer": "https://auth.example.com",
                    "clientId": "lynks",
                    "clientSecret": "abcdef123",
                    "redirectUri": "https://lynks.example.com/api/auth/oidc/callback",
                    "label": "Sign in with SSO"
                }
            },
            "database": {
                "url": "jdbc:postgresql://localhost:5432/lynksdb",
                "user": "lynksuser",
                "password": ""
            },
            "resource": {
                "resourceBasePath": "media",
                "resourceTempPath": "media/temp",
                "tempFileCleanInterval": 6,
                "maxTempResourceAge": 14
            },
            "external": {
                "youtubeApiKey": "abcdef123",
                "youtubeApiBaseUrl": "https://www.googleapis.com",
                "scraperHost": "http://localhost:3000/api",
                "joltHost": "https://jolt.example.com/api/v1"
            }
        }
    ],
    "properties": {
        "$schema": {
            "$id": "#/properties/$schema",
            "type": "string",
            "description": "Ref to configuration schema",
            "examples": [
                "https://raw.githubusercontent.com/raharrison/lynks-server/master/config/lynks.schema.json"
            ]
        },
        "server": {
            "$id": "#/properties/server",
            "type": "object",
            "description": "Core server configuration",
            "examples": [
                {
                    "host": "127.0.0.1",
                    "port": 8080,
                    "rootPath": "/api"
                }
            ],
            "properties": {
                "host": {
                    "$id": "#/properties/server/properties/host",
                    "type": "string",
                    "description": "The address the server should bind to, loopback by default since nginx proxies to it",
                    "examples": [
                        "127.0.0.1"
                    ]
                },
                "port": {
                    "$id": "#/properties/server/properties/port",
                    "type": "integer",
                    "description": "The port the server should bind to",
                    "examples": [
                        8080
                    ]
                },
                "rootPath": {
                    "$id": "#/properties/server/properties/rootPath",
                    "type": "string",
                    "description": "Root API path, to be the prefix for all routes",
                    "examples": [
                        "/api"
                    ]
                }
            },
            "additionalProperties": false
        },
        "auth": {
            "$id": "#/properties/auth",
            "type": "object",
            "description": "Authentication and authorization configuration",
            "examples": [
                {
                    "enabled": true,
                    "passwordLoginEnabled": true,
                    "defaultUserName": "user",
                    "defaultUserPassword": "abcdef123"
                }
            ],
            "properties": {
                "enabled": {
                    "$id": "#/properties/auth/properties/enabled",
                    "type": "boolean",
                    "description": "Protect all endpoints to be accessible only to authorized users",
                    "examples": [
                        true
                    ]
                },
                "passwordLoginEnabled": {
                    "$id": "#/properties/auth/properties/passwordLoginEnabled",
                    "type": "boolean",
                    "description": "If users can sign in with their username and password. The fallback when single sign-on is unavailable, so only turn it off once SSO works",
                    "examples": [
                        true
                    ]
                },
                "defaultUserName": {
                    "$id": "#/properties/auth/properties/defaultUserName",
                    "type": "string",
                    "description": "Username of the user created on first start. With auth disabled every request acts as this user, so it is created whenever it is missing",
                    "examples": [
                        "user"
                    ]
                },
                "defaultUserPassword": {
                    "$id": "#/properties/auth/properties/defaultUserPassword",
                    "type": "string",
                    "description": "Password raw text or bcrypt hash for the default user. With auth enabled and no users, nothing is created without it",
                    "examples": [
                        "abcdef123"
                    ]
                },
                "session": {
                    "$id": "#/properties/auth/properties/session",
                    "type": "object",
                    "description": "Lifetime of signed in sessions, which are stored in the database",
                    "properties": {
                        "idleDays": {
                            "$id": "#/properties/auth/properties/session/properties/idleDays",
                            "type": "integer",
                            "minimum": 1,
                            "description": "Days of inactivity after which a session expires",
                            "examples": [
                                30
                            ]
                        },
                        "maxDays": {
                            "$id": "#/properties/auth/properties/session/properties/maxDays",
                            "type": "integer",
                            "minimum": 1,
                            "description": "Days after sign in when a session expires however active it is. At least idleDays",
                            "examples": [
                                90
                            ]
                        }
                    },
                    "additionalProperties": false
                },
                "oidc": {
                    "$id": "#/properties/auth/properties/oidc",
                    "type": "object",
                    "description": "Single sign-on through an OpenID Connect provider such as Authelia. Needs auth.enabled",
                    "properties": {
                        "enabled": {
                            "$id": "#/properties/auth/properties/oidc/properties/enabled",
                            "type": "boolean",
                            "description": "Offer single sign-on alongside password login",
                            "examples": [
                                false
                            ]
                        },
                        "issuer": {
                            "$id": "#/properties/auth/properties/oidc/properties/issuer",
                            "type": "string",
                            "description": "Issuer url of the provider, whose /.well-known/openid-configuration is fetched on first use",
                            "examples": [
                                "https://auth.example.com"
                            ]
                        },
                        "clientId": {
                            "$id": "#/properties/auth/properties/oidc/properties/clientId",
                            "type": "string",
                            "description": "Client id registered with the provider",
                            "examples": [
                                "lynks"
                            ]
                        },
                        "clientSecret": {
                            "$id": "#/properties/auth/properties/oidc/properties/clientSecret",
                            "type": "string",
                            "description": "Client secret registered with the provider, should be kept secret",
                            "examples": [
                                "abcdef123"
                            ]
                        },
                        "redirectUri": {
                            "$id": "#/properties/auth/properties/oidc/properties/redirectUri",
                            "type": "string",
                            "description": "Callback registered with the provider. Configured rather than derived from request headers, so a spoofed header cannot change it",
                            "examples": [
                                "https://lynks.example.com/api/auth/oidc/callback"
                            ]
                        },
                        "label": {
                            "$id": "#/properties/auth/properties/oidc/properties/label",
                            "type": "string",
                            "description": "Text of the single sign-on button",
                            "examples": [
                                "Sign in with SSO"
                            ]
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "database": {
            "$id": "#/properties/database",
            "type": "object",
            "description": "Database configuration",
            "examples": [
                {
                    "url": "jdbc:postgresql://localhost:5432/lynksdb",
                    "user": "lynksuser",
                    "password": ""
                }
            ],
            "properties": {
                "url": {
                    "$id": "#/properties/database/properties/url",
                    "type": "string",
                    "description": "JDBC url for the PostgreSQL database instance",
                    "examples": [
                        "jdbc:postgresql://localhost:5432/lynksdb"
                    ]
                },
                "user": {
                    "$id": "#/properties/database/properties/user",
                    "type": "string",
                    "description": "Database username",
                    "examples": [
                        "lynksuser"
                    ]
                },
                "password": {
                    "$id": "#/properties/database/properties/password",
                    "type": "string",
                    "description": "Database password",
                    "examples": [
                        ""
                    ]
                }
            },
            "additionalProperties": false
        },
        "resource": {
            "$id": "#/properties/resource",
            "type": "object",
            "description": "An explanation about the purpose of this instance.",
            "examples": [
                {
                    "resourceBasePath": "media",
                    "resourceTempPath": "media/temp",
                    "tempFileCleanInterval": 6,
                    "maxTempResourceAge": 14
                }
            ],
            "properties": {
                "resourceBasePath": {
                    "$id": "#/properties/resource/properties/resourceBasePath",
                    "type": "string",
                    "description": "Location where all main entry resources will be saved",
                    "examples": [
                        "media"
                    ]
                },
                "resourceTempPath": {
                    "$id": "#/properties/resource/properties/resourceTempPath",
                    "type": "string",
                    "description": "Location where all temporary files will be saved",
                    "examples": [
                        "media/temp"
                    ]
                },
                "tempFileCleanInterval": {
                    "$id": "#/properties/resource/properties/tempFileCleanInterval",
                    "type": "integer",
                    "description": "Frequency in hours to delete temp resources which are passed threshold age",
                    "examples": [
                        6
                    ]
                },
                "maxTempResourceAge": {
                    "$id": "#/properties/resource/properties/maxTempResourceAge",
                    "type": "integer",
                    "description": "Maximum age of temp files in days before qualifying for cleanup",
                    "examples": [
                        14
                    ]
                }
            },
            "additionalProperties": false
        },
        "external": {
            "$id": "#/properties/external",
            "type": "object",
            "description": "An explanation about the purpose of this instance.",
            "examples": [
                {
                    "scraperHost": "http://localhost:3000/api",
                    "joltHost": "https://jolt.example.com/api/v1"
                }
            ],
            "properties": {
                "youtubeApiKey": {
                    "$id": "#/properties/external/properties/youtubeApiKey",
                    "type": "string",
                    "description": "API key for the YouTube Data API v3, used to enrich YouTube link metadata",
                    "examples": [
                        "abcdef123"
                    ]
                },
                "youtubeApiBaseUrl": {
                    "$id": "#/properties/external/properties/youtubeApiBaseUrl",
                    "type": "string",
                    "description": "Base URL of the YouTube Data API v3",
                    "examples": [
                        "https://www.googleapis.com"
                    ]
                },
                "scraperHost": {
                    "$id": "#/properties/external/properties/scraperHost",
                    "type": "string",
                    "description": "URL to the deployed Lynks scraper component",
                    "examples": [
                        "http://localhost:3000/api"
                    ]
                },
                "joltHost": {
                    "$id": "#/properties/external/properties/joltHost",
                    "type": "string",
                    "description": "Base URL of the jolt API used for outbound notifications. Each user sets their own inbound channel token in their profile",
                    "examples": [
                        "https://jolt.example.com/api/v1"
                    ]
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}
