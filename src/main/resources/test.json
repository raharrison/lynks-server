{
    "$schema": "https://raw.githubusercontent.com/raharrison/lynks-server/master/config/lynks.schema.json",
    "auth": {
        "enabled": false,
        "registrationsEnabled": true,
        "defaultUserName": "default",
        "defaultUserPassword": "test-default-password"
    },
    "database": {
        "url": "jdbc:postgresql://localhost:5432/lynksdb",
        "user": "lynksuser"
    },
    "resource": {
        "resourceBasePath": "media/test",
        "resourceTempPath": "media/test/temp"
    },
    "external": {
        "scraperHost": "http://localhost:3893/api",
        "youtubeApiKey": "test-api-key",
        "youtubeApiBaseUrl": "http://localhost:3893",
        "joltHost": "http://localhost:3893/api/v1",
        "joltToken": "jolt-token"
    }
}
